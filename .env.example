# ---------- LLM ----------
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=replace-with-production-model
BUSINESS_ZONE_ID=Asia/Shanghai

# ---------- MySQL / Redis / RocketMQ ----------
MYSQL_URL=jdbc:mysql://localhost:3306/expensepilot?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=root
MYSQL_PASSWORD=replace-me
REDIS_HOST=localhost
REDIS_PORT=6379
ROCKETMQ_NAMESRV=localhost:9876

# ---------- Production MCP: Email ----------
